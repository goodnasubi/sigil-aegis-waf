module shield_preface
  targets server
  trust none

use shield_proxy_v2.ProxyEndpoint;
use shield_proxy_v2.build_proxy_v2_header;
use shield_proxy_v2.new_ipv4;

fn emit(endpoint: &ProxyEndpoint, sni: &Option<String>) -> Int
  intent "固定版 shield-tls が生成した PROXY v2 のバイト列を試験へ渡す"
  requires none
  ensures none
  effects console
{
  match build_proxy_v2_header(&endpoint, &sni) {
    Ok(bytes) => {
      console.log(&bytes.byte_len());
      let mut i = 0;
      while i < bytes.byte_len() {
        console.log(&bytes.get(i).unwrap_or(0));
        i = i + 1;
      }
      return 0;
    }
    Err(_) => {
      return 1;
    }
  }
}

pub fn main() -> Int
  intent "IPv4 と SNI のない IPv6 の接続情報を生成する"
  requires none
  ensures none
  effects console
{
  let v4 = ProxyEndpoint.IPv4(new_ipv4(192, 0, 2, 10), 45678, new_ipv4(198, 51, 100, 20), 443);
  let v6 = ProxyEndpoint.IPv6(" \u{1}\r\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{1}".as_bytes(), 12345, " \u{1}\r\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{2}".as_bytes(), 8443);
  return emit(&v4, &Some("example.test")) + emit(&v6, &None);
}
