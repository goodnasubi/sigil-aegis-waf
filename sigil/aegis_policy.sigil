pub enum Action {
  Block,
  Challenge,
  LogOnly,
  Pass,
}

pub fn clone_action(action: &Action) -> Action
  intent "Action を複製する"
  requires none
  ensures none
  effects none
{
  return match action {
    Action.Block => Action.Block,
    Action.Challenge => Action.Challenge,
    Action.LogOnly => Action.LogOnly,
    Action.Pass => Action.Pass,
  };
}

pub fn clone_operator(op: &Operator) -> Operator
  intent "Operator を複製する"
  requires none
  ensures none
  effects none
{
  return match op {
    Operator.Exact => Operator.Exact,
    Operator.Prefix => Operator.Prefix,
    Operator.Contains => Operator.Contains,
    Operator.In => Operator.In,
  };
}

pub fn clone_target(target: &FieldTarget) -> FieldTarget
  intent "FieldTarget を複製する"
  requires none
  ensures none
  effects none
{
  return match target {
    FieldTarget.TargetMethod => FieldTarget.TargetMethod,
    FieldTarget.TargetPath => FieldTarget.TargetPath,
    FieldTarget.TargetQuery => FieldTarget.TargetQuery,
    FieldTarget.TargetHeader(hn) => FieldTarget.TargetHeader(hn.clone()),
    FieldTarget.TargetBody => FieldTarget.TargetBody,
  };
}

pub struct Header {
  header_name: String,
  header_val: String,
}

impl Header {
  pub fn new(name: String, value: String) -> Header
    intent "ヘッダーのキーと値を保持する"
    requires none
    ensures none
    effects none
  {
    return Header { header_name: name, header_val: value };
  }

  pub fn name(self: &Header) -> String
    intent "ヘッダー名を取得する"
    requires none
    ensures none
    effects none
  {
    return self.header_name.clone();
  }

  pub fn value(self: &Header) -> String
    intent "ヘッダー値を取得する"
    requires none
    ensures none
    effects none
  {
    return self.header_val.clone();
  }
}

pub struct RequestInput {
  req_method: String,
  req_path: String,
  req_query: String,
  req_headers: List<Header>,
  req_body: Bytes,
