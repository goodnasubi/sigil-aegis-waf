module aegis_policy
  targets server
  trust none

// ADR 0068 決定 2, 3, 7: ポリシーと検査の核（第1段）
// - 型付きの検査入力（RequestInput）と検査結果（Decision）
// - ポリシーとルールの宣言スキーマ（Policy, Rule, Exception）
// - 版付きの基本ルール（マネージドセット）
// - ルール ID と固定経路 ID を指定した、理由と失効日時付きの例外
// - ポリシーの原子的な差し替え（AegisEngine）

pub fn err_json_syntax() -> Int
  intent "JSON 構文エラーコードを返す"
  requires none
  ensures none
  effects none
{
  return 400;
}

pub fn err_unknown_field() -> Int
  intent "未知項目エラーコードを返す"
  requires none
  ensures none
  effects none
{
  return 401;
}

