  ex_route_id: String,
  ex_reason: String,
  ex_expires_at: Int,
}

impl Exception {
  pub fn new(rule_id: String, route_id: String, reason: String, expires_at: Int) -> Exception
    intent "例外を構築する"
    requires none
    ensures none
    effects none
  {
    return Exception { ex_rule_id: rule_id, ex_route_id: route_id, ex_reason: reason, ex_expires_at: expires_at };
  }

  pub fn rule_id(self: &Exception) -> String
    intent "対象ルール ID を取得する"
    requires none
    ensures none
    effects none
  {
    return self.ex_rule_id.clone();
  }

  pub fn route_id(self: &Exception) -> String
    intent "固定経路 ID を取得する"
    requires none
    ensures none
    effects none
  {
    return self.ex_route_id.clone();
  }

  pub fn reason(self: &Exception) -> String
    intent "例外の理由を取得する"
    requires none
    ensures none
    effects none
  {
    return self.ex_reason.clone();
  }

  pub fn expires_at(self: &Exception) -> Int
    intent "失効日時を取得する"
    requires none
    ensures none
    effects none
  {
    return self.ex_expires_at;
  }

  pub fn is_expired(self: &Exception, now: Int) -> Bool
    intent "指定時刻において例外が失効しているか調べる"
    requires none
    ensures none
    effects none
  {
    return now >= self.ex_expires_at;
  }
}

