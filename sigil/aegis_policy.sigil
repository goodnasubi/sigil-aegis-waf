    intent "型付きの検査入力を構築する"
    requires none
    ensures none
    effects none
  {
    return RequestInput { req_method: method, req_path: path, req_query: query, req_headers: headers, req_body: body, req_route_id: route_id };
  }

  pub fn method(self: &RequestInput) -> String
    intent "HTTP メソッドを取得する"
    requires none
    ensures none
    effects none
  {
    return self.req_method.clone();
  }

  pub fn path(self: &RequestInput) -> String
    intent "パスを取得する"
    requires none
    ensures none
    effects none
  {
    return self.req_path.clone();
  }

  pub fn query(self: &RequestInput) -> String
    intent "クエリ文字列を取得する"
    requires none
    ensures none
    effects none
  {
    return self.req_query.clone();
  }

  pub fn headers(self: &RequestInput) -> List<Header>
    intent "ヘッダー一覧を取得する"
    requires none
    ensures none
    effects none
  {
    return self.req_headers.clone();
  }

  pub fn body(self: &RequestInput) -> Bytes
    intent "本文を取得する"
    requires none
    ensures none
    effects none
  {
    return self.req_body.clone();
  }

  pub fn route_id(self: &RequestInput) -> String
    intent "固定経路 ID を取得する"
    requires none
    ensures none
    effects none
  {
    return self.req_route_id.clone();
  }
}

pub struct Decision {
  dec_action: Action,
  dec_rule_id: Option<String>,
  dec_reason: Option<String>,
  dec_version: String,
}

impl Decision {
  pub fn new(action: Action, matched_rule_id: Option<String>, reason: Option<String>, policy_version: String) -> Decision
    intent "検査結果を構築する"
    requires none
    ensures none
    effects none
  {
    return Decision { dec_action: action, dec_rule_id: matched_rule_id, dec_reason: reason, dec_version: policy_version };
  }

  pub fn action(self: &Decision) -> Action
    intent "判定結果の作用を返す"
    requires none
    ensures none
    effects none
  {
    return clone_action(&self.dec_action);
  }

  pub fn matched_rule_id(self: &Decision) -> Option<String>
    intent "一致したルール ID を返す"
    requires none
    ensures none
    effects none
  {
    return self.dec_rule_id.clone();
  }

  pub fn reason(self: &Decision) -> Option<String>
    intent "判定理由を返す"
    requires none
    ensures none
    effects none
  {
    return self.dec_reason.clone();
  }

  pub fn policy_version(self: &Decision) -> String
    intent "評価に使用されたポリシー版を返す"
    requires none
    ensures none
    effects none
  {
    return self.dec_version.clone();
  }
}

pub enum FieldTarget {
  TargetMethod,
  TargetPath,
  TargetQuery,
  TargetHeader(String),
  TargetBody,
}

pub enum Operator {
  Exact,
  Prefix,
  Contains,
  In,
}

pub struct Rule {
  r_id: String,
  r_route_id: Option<String>,
  r_target: FieldTarget,
  r_op: Operator,
  r_value: String,
  r_values: List<String>,
  r_action: Action,
  r_description: String,
}

impl Rule {
  pub fn new(id: String, route_id: Option<String>, target: FieldTarget, op: Operator, value: String, values: List<String>, action: Action, description: String) -> Rule
    intent "ルールを構築する"
    requires none
    ensures none
    effects none
  {
    return Rule { r_id: id, r_route_id: route_id, r_target: target, r_op: op, r_value: value, r_values: values, r_action: action, r_description: description };
  }

  pub fn id(self: &Rule) -> String
    intent "ルール ID を取得する"
    requires none
    ensures none
    effects none
  {
    return self.r_id.clone();
  }

  pub fn route_id(self: &Rule) -> Option<String>
    intent "対象経路 ID を取得する（None なら全経路）"
    requires none
    ensures none
    effects none
  {
    return self.r_route_id.clone();
  }

  pub fn target(self: &Rule) -> FieldTarget
    intent "検査対象フィールドを取得する"
    requires none
    ensures none
    effects none
  {
    return clone_target(&self.r_target);
  }

  pub fn op(self: &Rule) -> Operator
    intent "演算子を取得する"
    requires none
    ensures none
    effects none
  {
    return clone_operator(&self.r_op);
  }

  pub fn value(self: &Rule) -> String
    intent "演算子の値を参照する"
    requires none
    ensures none
    effects none
  {
    return self.r_value.clone();
  }

  pub fn values(self: &Rule) -> List<String>
    intent "集合演算用の値一覧を参照する"
    requires none
    ensures none
    effects none
  {
    return self.r_values.clone();
  }

  pub fn action(self: &Rule) -> Action
    intent "ルールの作用を取得する"
    requires none
    ensures none
    effects none
  {
    return clone_action(&self.r_action);
  }

  pub fn description(self: &Rule) -> String
    intent "ルールの説明文を取得する"
    requires none
    ensures none
    effects none
  {
    return self.r_description.clone();
  }
}

