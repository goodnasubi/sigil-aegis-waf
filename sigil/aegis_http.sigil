module aegis_http
  targets server
  trust none

use aegis_budget.Inspection;
use aegis_budget.Rejection;
use aegis_budget.expired;
use aegis_budget.pinned_limits;
use aegis_budget.rejection;
use aegis_budget.stronger;
use aegis_ip.IpEffect;
use aegis_ip.IpTable;
use aegis_ip.evaluate_ip;
use aegis_ip.ip_version;
use aegis_limit.Admission;
use aegis_limit.Limiter;
use aegis_limit.admit;
use aegis_observe.Event;
use aegis_observe.event;
use aegis_policy.Action;
use aegis_policy.Decision;
use aegis_policy.Header;
use aegis_policy.Policy;
use aegis_policy.RequestInput;
use aegis_policy.evaluate;
use aegis_policy.to_ascii_lower;
use aegis_proxy.ProxyMetadata;
use aegis_proxy.authority;
use aegis_proxy.host_name;
use aegis_proxy.source;
use aegis_routes.Route;
use aegis_routes.route_id;

fn hop_header(name: &String) -> Bool
  intent "転送しない接続・フレーミング・転送元の見出しを識別する"
  requires none
  ensures none
  effects none
{
  return name == "connection" || name == "keep-alive" || name == "proxy-connection" || name == "proxy-authorization" || name == "proxy-authenticate" || name == "te" || name == "trailer" || name == "transfer-encoding" || name == "upgrade" || name == "content-length" || name == "expect" || name == "forwarded" || name.as_bytes().slice(0, 12).unwrap_or(Bytes.new()) == "x-forwarded-".as_bytes();
}

fn decimal(n: Int) -> Bytes
  intent "転送する本文の長さを十進表記にする"
  requires none
  ensures none
  effects none
{
  let mut digits = Bytes.new();
  let mut factor = 1;
  while n / factor >= 10 {
    factor = factor * 10;
  }
  while factor > 0 {
    digits.push(48 + n / factor % 10);
    factor = factor / 10;
  }
  return digits;
}

fn version_of(chunks: &List<Policy>) -> String
  intent "Read the policy version shared by every work unit."
  requires none
  ensures none
  effects none
{
  return match chunks.get(0) {
    Some(unit) => unit.version(),
    None => "",
  };
}

fn late(route: &String, chunks: &List<Policy>, observations: &mut List<Event>) -> Rejection
  intent "Reject a request whose inspection deadline has passed; nothing unchecked is forwarded."
  requires none
  ensures none
  effects none
{
  observations.push(event("reject", "decision_deadline", "", route.clone(), version_of(&chunks), false, false));
  return rejection(503, 0);
}

pub fn check_request(req: &HttpRequest, meta: &ProxyMetadata, now: Int, ip_table: &IpTable, chunks: &List<Policy>, routes: &List<Route>, counters: &Lock<Limiter>, watch: &mut Inspection, observations: &mut List<Event>) -> Result<Bytes, Rejection>
  intent "検査を終えた要求だけを一意のフレーミングで組み立て、期限とレート制限を適用する"
  requires none
  ensures none
  effects clock, task.share, task.suspend
{
  if expired(&mut watch) {
    return Err(late(&"default", &chunks, &mut observations));
  }
  if req.version() != 11 {
    return Err(rejection(505, 0));
  }
  let host = req.header(&"host").unwrap_or(Bytes.new());
  match authority(&meta) {
    Some(sni) => {
      match host_name(&host) {
        Ok(name) => {
          if sni != name {
            return Err(rejection(421, 0));
          }
        }
        Err(_) => {
          return Err(rejection(421, 0));
        }
      }
    }
    None => {
      if host.byte_len() == 0 {
        return Err(rejection(400, 0));
      }
    }
  }

  let path = req.path();
  let query = req.query();
  let path_text = path.to_string_utf8();
  let query_text = query.to_string_utf8();
  if path_text.is_err() || query_text.is_err() {
    return Err(rejection(400, 0));
  }
  let mut input_headers = List.new();
  let mut wire_headers = Bytes.new();
  let mut header_count = 1;  // Connection: close
  let headers = req.headers();
  let mut i = 0;
  while i < headers.len() {
    match headers.get(i) {
      Some(header) => {
        let name = header.name();
        let value = header.value();
        let text = value.to_string_utf8();
        if text.is_err() {
          return Err(rejection(400, 0));
        }
        let value_text = text.unwrap_or("");
        if name == "connection" {
          let option = to_ascii_lower(&value_text);
          if option != "close" && option != "keep-alive" {
            return Err(rejection(400, 0));
          }
        }
        input_headers.push(Header.new(name.clone(), value_text));
        if !hop_header(&name) {
          wire_headers.extend(&name.as_bytes());
          wire_headers.extend(&": ".as_bytes());
          wire_headers.extend(&value);
          wire_headers.extend(&"\r\n".as_bytes());
          header_count = header_count + 1;
        }
      }
      None => {}
    }
    i = i + 1;
  }
  let route = route_id(&routes, &path_text.clone().unwrap_or(""));
  match evaluate_ip(&ip_table, &source(&meta), now) {
    IpEffect.Block(reason) => {
      observations.push(event("block", reason, "", route.clone(), ip_version(&ip_table), false, true));
      return Err(rejection(403, 0));
    }
    IpEffect.Record(reason) => {
      observations.push(event("detect", reason, "", route.clone(), ip_version(&ip_table), false, true));
    }
    IpEffect.NoMatch => {}
  }
  let body = req.body();
  if body.byte_len() != 0 || req.header(&"content-length").is_some() || req.header(&"transfer-encoding").is_some() {
    wire_headers.extend(&"content-length: ".as_bytes());
    wire_headers.extend(&decimal(body.byte_len()));
    wire_headers.extend(&"\r\n".as_bytes());
    header_count = header_count + 1;
  }
  wire_headers.extend(&"connection: close\r\n".as_bytes());
  if wire_headers.byte_len() > pinned_limits(1).head() || header_count > pinned_limits(1).headers() {
    return Err(rejection(431, 0));
  }

  // 経路の確定後、本文の検査前に制限を適用する（ADR 0068 決定 4）。
  match clock.monotonic_nanos() {
    Some(tick) => {
      match admit(&counters, &source(&meta), &route, tick) {
        Admission.Allow => {}
        Admission.Limited(seconds) => {
          observations.push(event("reject", "rate_limited", "", route.clone(), version_of(&chunks), false, false));
          return Err(rejection(429, seconds));
        }
        Admission.Unavailable => {
          observations.push(event("reject", "rate_table_full", "", route.clone(), version_of(&chunks), false, false));
          return Err(rejection(503, 0));
        }
      }
    }
    None => {
      return Err(late(&route, &chunks, &mut observations));
    }
  }

  let method = req.method();
  let input = RequestInput.new(method.clone(), path_text.unwrap_or(""), query_text.unwrap_or(""), input_headers, body.clone(), route.clone());
  // 作業単位（ルール数を限った一括）ごとに期限を確かめる。作業単位の間では制御を手放さない。
  let mut decision = Decision.new(Action.Pass, None, None, version_of(&chunks));
  let mut unit = 0;
  while unit < chunks.len() {
    if expired(&mut watch) {
      return Err(late(&route, &chunks, &mut observations));
    }
    match chunks.get(unit) {
      Some(rules) => {
        decision = stronger(decision, evaluate(&rules, &List.new(), &input, now));
      }
      None => {}
    }
    unit = unit + 1;
  }
  match decision.action() {
    Action.Block => {
      observations.push(event("block", "policy_block", decision.matched_rule_id().unwrap_or(""), route.clone(), decision.policy_version(), false, true));
      return Err(rejection(403, 0));
    }
    Action.Challenge => {
      observations.push(event("challenge", "challenge_required", decision.matched_rule_id().unwrap_or(""), route.clone(), decision.policy_version(), false, true));
      return Err(rejection(403, 0));
    }
    Action.LogOnly => {
      observations.push(event("detect", "log_only", decision.matched_rule_id().unwrap_or(""), route.clone(), decision.policy_version(), false, true));
    }
    Action.Pass => {}
  }

  let mut request = method.as_bytes();
  request.extend(&" ".as_bytes());
  request.extend(&path);
  if query.byte_len() > 0 {
    request.extend(&"?".as_bytes());
    request.extend(&query);
  }
  request.extend(&" HTTP/1.1\r\n".as_bytes());
  request.extend(&wire_headers);
  request.extend(&"\r\n".as_bytes());
  request.extend(&body);
  if expired(&mut watch) {
    return Err(late(&route, &chunks, &mut observations));
  }
  return Ok(request);
}
